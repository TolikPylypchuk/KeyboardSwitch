#!/usr/bin/env bash

mkdir -p /opt

if [ "$1" == "purge" ]
then
    awk -F: '($3 >= 1000) && ($3 < 60000) && ($1 != "nobody") { print $1 }' /etc/passwd | while read -r CURRENT_USER
    do
        if [ -d "$(eval echo ~$CURRENT_USER)/.config/keyboard-switch" ]
        then
            rm -rf "$(eval echo ~$CURRENT_USER)/.config/keyboard-switch"
        fi
    done

    rm -f /etc/udev/rules.d/99-keyboard-switch.rules /etc/modules-load.d/keyboard-switch.conf
    udevadm control --reload-rules
    udevadm trigger --subsystem-match=input --subsystem-match=misc

    getent group keyboard-switch &>/dev/null && groupdel keyboard-switch
fi
